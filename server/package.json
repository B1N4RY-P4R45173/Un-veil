{
  "name": "unveil-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "NODE_ENV=test SAFE_PERIOD_SECONDS=1 DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres@127.0.0.1:5432/unveil_test} node --test --test-concurrency=1 test/*.test.js",
    "fetch-model": "node scripts/fetch-model.js",
    "postinstall": "node scripts/fetch-model.js"
  },
  "engines": {
    "node": "^20 || ^22"
  },
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.22.0",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "tar": "^7.5.22",
    "adm-zip": "^0.6.1",
    "@mapbox/node-pre-gyp": "^2.0.3",
    "sprintf-js": "^1.1.3"
  }
}
