# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://unveil:unveil@localhost:5432/unveil
REDIS_URL=redis://localhost:6379

# Long random strings, e.g. `openssl rand -hex 32`. Required in production.
JWT_SECRET=
CAPTCHA_SECRET=

# Minimum time (seconds) a chat must last before either person can reveal.
SAFE_PERIOD_SECONDS=300

# First admin account, created/updated by `npm run seed`.
ADMIN_EMAIL=admin@unveil.local
ADMIN_PASSWORD=

# Email for OTP codes. Leave SMTP_HOST empty in development: codes print to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Unveil <no-reply@your-domain>

# Where the toxicity model lives (downloaded by `npm run fetch-model`, also run on install).
# TOXICITY_MODEL_DIR=server/models/toxicity
