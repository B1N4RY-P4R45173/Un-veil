# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://unveil:unveil@localhost:5432/unveil
REDIS_URL=redis://localhost:6379

# Password for the bundled Postgres container (docker-compose.yml).
POSTGRES_PASSWORD=

# Long random strings, e.g. `openssl rand -hex 32`. Required in production.
JWT_SECRET=
CAPTCHA_SECRET=

# Minimum time (seconds) a chat must last before either person can reveal.
SAFE_PERIOD_SECONDS=300

# First admin account, created/updated by `npm run seed`. At least 12 characters in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Chat messages older than this are deleted (unless an open report needs them as evidence).
MESSAGE_RETENTION_DAYS=30

# How many reverse proxies sit in front of the app (used for client IPs in rate limits and logs).
TRUST_PROXY=1

# Email for sign-up and password-reset codes. Required in production.
# Leave SMTP_HOST empty in development: codes print to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Unveil <no-reply@your-domain>

# Where the toxicity model lives (downloaded by `npm run fetch-model`, also run on install).
# TOXICITY_MODEL_DIR=server/models/toxicity

# Public address of the site (used for the Microsoft sign-in redirect).
PUBLIC_URL=https://your-domain

# "Sign in with Microsoft": create an app registration in Microsoft Entra ID
# (multitenant, redirect URI <PUBLIC_URL>/api/auth/microsoft/callback, type Web) and paste its
# Application (client) ID and a client secret here. Leave empty to hide the button.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: only accept accounts from these directory (tenant) IDs, comma-separated.
MICROSOFT_ALLOWED_TENANTS=
# Set to false to allow only Microsoft sign-up (email + password sign-up turned off).
PASSWORD_SIGNUP=true
